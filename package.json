{
  "name": "convex-plunk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pack:check": "node scripts/check-package.mjs",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "convex": "1.49.0",
    "turbo": "2.11.10"
  }
}
